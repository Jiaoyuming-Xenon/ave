# Local reference checkouts. Restore exact revisions with scripts/bootstrap_references.py.
/pi/
/paseo/
/filmcraft/
/.filmcraft-incomplete-backup/
/references/
# Runnable local checkout; the publishable source delta lives in downstream/paseo/.
/vendor/paseo/
# Local tooling binaries (e.g. a newer static FFmpeg for the media tests).
/.tools/

# Local session evidence and large source material.
/1.txt
/*.pdf
/research/sources/

# Python.
__pycache__/
*.py[cod]
.venv/

# JavaScript and application build outputs.
node_modules/
dist/
build/
out/
coverage/
*.tsbuildinfo

# Native installers, media, caches and secrets.
*.AppImage
*.apk
*.dmg
*.exe
*.mp4
*.mov
*.mkv
*.env
.env.*
!.env.example
*.pem
*.key
.DS_Store
Thumbs.db

